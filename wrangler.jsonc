{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainstorm",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  // Path routes only — a Custom Domain on the apex would steal entangleit.com
  // from the existing site, same as SatPress.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "entangleit.com/brainstorm", "zone_name": "entangleit.com" },
    { "pattern": "entangleit.com/brainstorm/*", "zone_name": "entangleit.com" }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/brainstorm/api/*", "/brainstorm/ws/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainstorm",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "SessionRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }
  ]
}