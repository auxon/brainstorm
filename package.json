{
  "name": "brainstorm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && vite preview --host 0.0.0.0 --port 5173",
    "deploy": "BRAINSTORM_BASE_PATH=/brainstorm vite build && wrangler d1 migrations apply brainstorm --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply brainstorm --local",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "check": "wrangler types && tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@1sat/actions": "^0.0.197",
    "@1sat/client": "^0.0.49",
    "@1sat/connect": "^0.0.88",
    "@1sat/react": "^0.0.85",
    "@bsv/sdk": "^2.4.1",
    "@xyflow/react": "^12.8.2",
    "hono": "^4.9.8",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.8.2",
    "sonner": "^2.0.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}